{
    "name": "velozz-crm",
    "version": "1.0.0",
    "description": "Velozz CRM — Google Forms → Sheets → Contacts com sync bidirecional. SaaS-ready.",
    "author": "Claudio Alejandro Ramirez",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "bundle": "node scripts/bundle.js",
        "deploy": "npm run bundle && clasp push",
        "deploy:force": "npm run bundle && clasp push --force",
        "pull": "clasp pull",
        "open": "clasp open",
        "lint": "eslint src/**/*.js scripts/**/*.js",
        "lint:fix": "eslint src/**/*.js scripts/**/*.js --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "version:bump": "node scripts/bump-version.js",
        "setup:clasp": "clasp login && clasp clone"
    },
    "devDependencies": {
        "@google/clasp": "^3.3.0",
        "eslint": "^8.57.0",
        "eslint-config-google": "^0.14.0",
        "jest": "^29.7.0",
        "jest-environment-node": "^29.7.0"
    }
}